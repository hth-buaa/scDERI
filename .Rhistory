# 7.2 Collect and combine results
mean.prec = list(mean.prec_df_list = list())
for (i in 1:length(results)) {mean.prec = c(mean.prec, results[[i]])}
# 7.3 Select top performing weight combinations
if (item == 1) {mean.prec_df_list = list()}
if (obs == "precision") {
# mean.prec_df_list[[item]] = do.call(rbind, mean.prec) %>% dplyr::arrange(dplyr::desc(precision)) %>% dplyr::slice_head(n = topn_keep)
mean.prec_df_list[[item]] = do.call(rbind, mean.prec) %>% dplyr::arrange(dplyr::desc(precision), dplyr::desc(prec_mean), dplyr::desc(npeaks_mean)) %>% dplyr::slice_head(n = topn_keep)
# mean.prec_df_list[[item]] = rbind(do.call(rbind, mean.prec), a1) %>% dplyr::arrange(dplyr::desc(precision), dplyr::desc(prec_mean), dplyr::desc(npeaks_mean)) %>% dplyr::slice_head(n = topn_keep)
} else if (obs == "npeaks_mean") {
mean.prec_df_list[[item]] = do.call(rbind, mean.prec) %>% dplyr::arrange(desc(npeaks_mean)) %>% dplyr::slice_head(n = topn_keep)
} else {stop("error")}
# Option to add previous best result
if (item == 1 && add_optimal_before && exists("res_best")) {
# If you wish to resume training from previous results after training is complete and reset the number of training epochs, use this to load the previously obtained optimal parameters.
message("[times ", times, ", item ", item, "] Add the optimal parameter values obtained from previous training.")
mean.prec_df_list[[1]][2, ] = res_best
mean.prec_df_list[[1]][2, 6] = 0
}
# 7.4 Get overall best results
if (obs == "precision") {
# mean.prec_df_top = do.call(rbind, mean.prec_df_list) %>% arrange(dplyr::desc(precision), dplyr::desc(prec_mean), dplyr::desc(npeaks_mean)) %>% slice_head(n = topn_keep)
mean.prec_df_top = do.call(rbind, mean.prec_df_list) %>% arrange(dplyr::desc(precision), dplyr::desc(prec_mean), dplyr::desc(npeaks_mean)) %>% dplyr::filter(npeaks_mean > 45) %>% slice_head(n = topn_keep)
} else if (obs == "npeaks_mean") {
mean.prec_df_top = do.call(rbind, mean.prec_df_list) %>% arrange(desc(npeaks_mean)) %>% slice_head(n = topn_keep)
} else {stop("error")}
rownames(mean.prec_df_top) = NULL
# colnames(mean.prec_df_top) = NULL
message("\n[times ", times, ", item ", item, "] -----> mean.prec_df_top: ")
# print(round(mean.prec_df_top, digits = 3))
print(mean.prec_df_top[, 1:6])
print(mean.prec_df_top[, 1]) # print precision
print(mean.prec_df_top[, 5]) # print npeaks_mean
print(min(mean.prec_df_top[, 5])) # print min_npeaks_mean_all
print(max(mean.prec_df_top[, 5])) # print max_npeaks_mean_all
print(apply(mean.prec_df_top[, -c(1:6)], 2, max, na.rm = TRUE))
print(apply(mean.prec_df_top[, -c(1:6)], 2, min, na.rm = TRUE))
print(as.numeric(apply(mean.prec_df_top[, -c(1:6)], 2, max, na.rm = TRUE) - apply(mean.prec_df_top[, -c(1:6)], 2, min, na.rm = TRUE)))
